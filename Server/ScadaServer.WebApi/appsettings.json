{
  "SystemDbConfig": {
    "Host": "localhost",
    "Port": 3306,
    "DatabaseName": "scada",
    "Username": "root",
    "Password": "",
    "_comment": "数据库密码不再写入配置文件。生产环境必须通过环境变量 SystemDbConfig__Password 注入（Linux 部署为 export SystemDbConfig__Password=xxx）。"
  },
  "Jwt": {
    "Issuer": "ScadaServer",
    "Audience": "ScadaClient",
    "Key": "dev-only-jwt-signing-key-do-not-use-in-production-0123456789",
    "ExpireHours": 8,
    "_comment": "JWT 签名密钥（>=32字符）。此处为开发占位，生产环境必须通过环境变量 Jwt__Key 覆盖，否则视为已泄漏。ExpireHours 为 Token 有效期（小时），默认 8。"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AllowedCorsOrigins": [
    "http://localhost:3333",
    "http://192.168.1.30:3333",
    "http://100.88.88.5:3333",
    "http://100.88.88.1:3333"
  ]
}