{
  "SystemDbConfig": {
    "Host": "localhost",
    "Port": 3306,
    "DatabaseName": "scada",
    "Username": "root",
    "Password": "Pgw15221236646",
    "_comment": "数据库连接配置。密码已写入本配置文件，启动时无需再通过命令行环境变量 SystemDbConfig__Password 注入。"
  },
  "Jwt": {
    "Issuer": "ScadaServer",
    "Audience": "ScadaClient",
    "Key": "dev-only-jwt-signing-key-do-not-use-in-production-0123456789",
    "ExpireHours": 8,
    "_comment": "JWT 签名密钥（>=32字符）。此处为开发占位，生产环境必须通过环境变量 Jwt__Key 覆盖，否则视为已泄漏。ExpireHours 为 Token 有效期（小时），默认 8。"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "SystemLog": {
    "MinLevel": "Information",
    "MaxContentLength": 2000,
    "IgnoreCategories": [
      "Microsoft.",
      "System.Net."
    ],
    "IgnoreExactCategories": [
      "ScadaServer.WebApi.HostedServices.SystemLogRecorder",
      "ScadaServer.WebApi.Logging.DatabaseLoggerProvider"
    ],
    "Retention": {
      "Runtime": 30,
      "Operation": 180,
      "Security": 365
    },
    "_comment": "运行日志写库最低级别 MinLevel；IgnoreCategories 前缀黑名单（框架噪音）；IgnoreExactCategories 全名黑名单（防递归写库）；Retention 为各分类日志保留天数，由自动清理任务使用。"
  },
  "Notification": {
    "_comment": "外部消息通知（钉钉群机器人 + SMTP 邮件）。敏感项走环境变量：Notification__DingTalk__Secret、Notification__Email__Username、Notification__Email__Password。两渠道默认关闭，Enabled=false 时零影响。",
    "DingTalk": {
      "Enabled": false,
      "Webhook": "https://oapi.dingtalk.com/robot/send?access_token=在此替换",
      "Secret": ""
    },
    "Email": {
      "Enabled": false,
      "SmtpHost": "smtp.example.com",
      "SmtpPort": 465,
      "UseSsl": true,
      "Username": "",
      "Password": "",
      "From": "scada@example.com",
      "FromName": "SCADA 报警中心",
      "To": ["receiver@example.com"]
    },
    "Push": {
      "PushAlarm": true,
      "PushDeviceOffline": true,
      "PushDeviceOnline": false,
      "DeviceStatusDebounceMinutes": 5,
      "PushSystemAlarm": true,
      "PushSystemError": true,
      "PushScript": true,
      "MaxPerMinutePerChannel": 15,
      "MaxAttempts": 2,
      "RetryBaseDelayMs": 1000,
      "QueueCapacity": 2048
    }
  },
  "HmiImage": {
    "StoragePath": "uploads/hmi-images",
    "MaxFileSizeMB": 10,
    "AllowedExtensions": [".png", ".jpg", ".jpeg", ".gif", ".webp", ".svg"],
    "_comment": "组态图片图库存储。StoragePath 相对 ContentRoot，首次上传自动创建目录；上传/删除走 RequireAdmin，读取匿名可达（运行端画面加载图片）。"
  },
  "Scripting": {
    "Consumers": 2,
    "QueueCapacity": 256,
    "WriteBridgeTimeoutMs": 6000,
    "_comment": "脚本引擎派发配置：Consumers=专用消费线程数（LongRunning，非线程池）；QueueCapacity=有界派发队列容量，队满丢弃触发并计数告警；WriteBridgeTimeoutMs=脚本 write 桥同步等待上界，应 ≥ Devices:WriteTimeoutMs。"
  },
  "Devices": {
    "WriteTimeoutMs": 5000,
    "_comment": "变量写入（RuntimeManager → 驱动）兜底超时（毫秒）。驱动层（如 S7Driver）可经 JsonConfig 的 IoTimeoutMs/ConnectTimeoutMs 按设备覆盖。"
  },
  "AllowedHosts": "*",
  "AllowedCorsOrigins": [
    "http://localhost:3333",
    "http://192.168.1.30:3333",
    "http://100.88.88.5:3333",
    "http://100.88.88.1:3333"
  ]
}